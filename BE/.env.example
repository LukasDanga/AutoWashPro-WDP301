PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/washpro

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_in_production
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated, FE_URL is the main one
FE_URL=http://localhost:5173
CORS_ORIGINS=

# Payment (SePay)
SEPAY_API_KEY=your_sepay_key
SEPAY_BANK_ID=MB
SEPAY_BANK_ACCOUNT=your_account_number

# Admin
ADMIN_EMAIL=admin@washpro.vn
ADMIN_PASSWORD=Admin123!

# VNPay
VNPAY_TMNCODE=your_vnp_tmncode
VNPAY_HASH_SECRET=your_vnp_hashsecret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-domain.com/api/payments/vnpay-return

# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_RETURN_URL=

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google OAuth
GOOGLE_WEB_CLIENT_ID=your_google_client_id

# Chatbot
OPENROUTER_API_KEY=your_openrouter_key
CHATBOT_BASE_URL=https://openrouter.ai/api/v1
CHATBOT_MODEL=google/gemini-2.5-flash
